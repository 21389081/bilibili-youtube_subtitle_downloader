{
  "manifest_version": 3,
  "name": "字幕下載 — YouTube 與 Bilibili",
  "description": "下載目前影片的現成字幕，移除時間碼，每段一行匯出 TXT。",
  "version": "0.1.1",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "action": {
    "default_title": "字幕下載",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "16": "icons/icon-16.png",
      "128": "icons/icon-128.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "48": "icons/icon-48.png",
    "16": "icons/icon-16.png",
    "128": "icons/icon-128.png",
    "32": "icons/icon-32.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "subtitle-text-downloader@vincent-chen",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
