{
  "name": "subtitle-text-downloader",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:layout": "node tests/layout.e2e.cjs",
    "check": "node scripts/check.mjs",
    "package": "node scripts/package.mjs",
    "build:firefox": "node scripts/build-firefox.mjs",
    "package:firefox": "node scripts/package-firefox.mjs",
    "check:firefox": "node scripts/check-firefox.mjs",
    "lint:firefox": "node scripts/build-firefox.mjs && node node_modules/web-ext/bin/web-ext.js lint --source-dir dist/firefox --warnings-as-errors",
    "sync:firefox": "node scripts/sync-firefox-assets.mjs",
    "test:firefox-layout": "node tests/firefox-layout.e2e.cjs"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "web-ext": "10.8.0"
  },
  "engines": {
    "node": ">=20"
  }
}
